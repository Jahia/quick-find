    "lint:fix": "yarn lint --fix"
  },
  "peerDependencies": {
    "@jahia/ui-extender": "^2.0.0",
    "i18next": ">=23.16.8 <27",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-i18next": ">=15.7.4 <18"
  },
  "dependencies": {
    "@apollo/client": "^3.11.0",
    "@jahia/moonstone": "2.19.0",
    "graphql": "^16.13.1"
  },
  "devDependencies": {
    "@jahia/eslint-config": "^2.2.0",
    "@jahia/ui-extender": "2.0.0",
    "@jahia/vite-federation-plugin": "^0.2.1",
    "@types/react": "~18.3",
    "@types/react-dom": "~18.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^8.57.1",
    "eslint-plugin-json": "^4.0.1",
    "i18next": "23.16.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "jahia": {
